@startuml
title Pay a Bill (US-12, US-18, US-20)

autonumber
skinparam sequenceMessageAlign center

actor "Customer\n(AppUser)" as Customer
participant "Payment" as Payment
participant "FeeRule" as Fee
participant "FraudRule" as Fraud
participant "Wallet" as Wallet
participant "LedgerEntry" as Ledger
participant "Biller\n(ElectroCo)" as Biller <<external>>
participant "Notification" as Notif

note over Customer, Payment
    Bill inquiry was already done: amount 350.00.
    The request carries an idempotency key.
end note

Customer -> Payment : confirm payment
Payment -> Fee : calculate(350.00)
Fee --> Payment : fee 2.50, total 352.50
Payment -> Payment : create payment [INITIATED]

Payment -> Fraud : check(payment)
alt blocked account / limit exceeded
    Fraud --> Payment : failed (e.g. "account blocked")
    Payment -> Payment : [INITIATED -> REJECTED]
    Payment --> Customer : Rejected + reason
else checks passed
    Fraud --> Payment : passed

    == US-18: hold funds before the biller is called ==
    Payment -> Wallet : hold(352.50)
    alt not enough available balance
        Wallet --> Payment : failed
        Payment -> Payment : [INITIATED -> REJECTED]
        Payment --> Customer : Rejected "insufficient funds"\n(biller is never called)
    else hold created
        Wallet -> Ledger : add HOLD entry
        Wallet --> Payment : available 647.50, held 352.50
        Payment -> Payment : [INITIATED -> FUNDS_HELD]

        == US-12: call the biller ==
        Payment -> Payment : [FUNDS_HELD -> SENT_TO_BILLER]
        Payment -> Biller : pay(billerReference)

        alt biller confirms
            Biller --> Payment : paid
            Payment -> Ledger : add CHARGE (hold becomes final charge)\n+ FEE_INCOME
            opt payment made by an agent
                Payment -> Ledger : add COMMISSION (40% of fee)
            end
            Payment -> Payment : [SENT_TO_BILLER -> COMPLETED]
            Payment -> Notif : send receipt (SMS + push)
            Payment --> Customer : Completed
        else biller refuses
            Biller --> Payment : refused (error code)
            Payment -> Payment : [SENT_TO_BILLER -> FAILED]
            note right : Hold release and refund:\nsee "Refund a Failed Payment"
            Payment --> Customer : Failed
        else US-20: no answer within 10 seconds
            Payment -> Payment : [SENT_TO_BILLER -> UNKNOWN]
            note right : Money stays held.\nNever refunded automatically.
            Payment --> Customer : "your payment is being processed"
        end
    end
end

note over Ledger
    Every ledger entry also gets an AuditLog record (US-36).
end note

@enduml
