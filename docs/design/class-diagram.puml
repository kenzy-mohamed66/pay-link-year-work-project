@startuml PayLink_Domain_Class_Diagram
title PayLink - Domain Class Diagram
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 50
hide empty members

' ===== Accounts and Wallet =====
class AppUser {
  fullName
  phone
  email
  role : CUSTOMER | AGENT | ADMIN | SUPPORT
  verificationLevel : BASIC | VERIFIED
  isBlocked
  blockedUntil
  dailyLimit() : Decimal
}

class Wallet {
  currency = "EGP"
  availableBalance() : Decimal
  heldBalance() : Decimal
}

class LedgerEntry <<immutable>> {
  entryType : LedgerEntryType
  bucket : AVAILABLE | HELD
  amount : Decimal
  agentId
  description
  createdAt
}

enum LedgerEntryType {
  TOP_UP
  HOLD
  HOLD_RELEASE
  CHARGE
  FEE_INCOME
  COMMISSION
  REFUND
}

AppUser "1" -- "0..1" Wallet : owns
Wallet "1" *-- "0..*" LedgerEntry : records
LedgerEntry --> LedgerEntryType

' ===== Approvals =====
class VerificationRequest {
  status : PENDING | APPROVED | REJECTED
  decidedBy
  requestedAt
  decidedAt
}

class RefundRequest {
  amount : Decimal
  reason
  status : PENDING | APPROVED | REJECTED
  decidedBy
  requestedAt
  decidedAt
}

AppUser "1" -- "0..*" VerificationRequest : asks upgrade
AppUser "1" -- "0..*" RefundRequest : requests

' ===== Biller Catalog and Fees =====
class Biller {
  code
  name
  protocol : REST | SOAP | ASYNC | BATCH
  isActive
}

class BillerService {
  name
  minAmount : Decimal
  maxAmount : Decimal
  isActive
}

class ServiceInputField {
  fieldName
  label
  isRequired
}

class FeeRule {
  feeType : FIXED | PERCENT | TIERED
  fixedAmount : Decimal
  percentRate : Decimal
  minFee : Decimal
  tierThreshold : Decimal
  tierLowFee : Decimal
  tierHighFee : Decimal
  calculate(amount) : Decimal
}

class Promotion {
  startDate
  endDate
  feeOverride : Decimal = 0
}

Biller "1" *-- "1..*" BillerService : offers
BillerService "1" *-- "0..*" ServiceInputField : requires
BillerService "1" -- "1" FeeRule : priced by
Biller "1" -- "0..*" Promotion : may run

' ===== Payment Processing =====
enum PaymentState {
  INITIATED
  FUNDS_HELD
  SENT_TO_BILLER
  COMPLETED
  FAILED
  UNKNOWN
  REJECTED
  REFUNDED
}

class Payment {
  reference
  idempotencyKey
  requestHash
  keyExpiresAt
  billerReference
  amount : Decimal
  feeAmount : Decimal
  totalAmount : Decimal
  status : PaymentState
  failureReason
  retryCount
  nextRetryAt
  awaitingReconciliation
  createdAt
  updatedAt
}

class PaymentStateHistory <<immutable>> {
  fromStatus
  toStatus
  reason
  changedAt
}

class FraudRule {
  ruleType : DAILY_LIMIT | VELOCITY | BLOCKED_ACCOUNT
  check(payment)
}

AppUser "1" -- "0..*" Payment : pays as customer
AppUser "0..1" -- "0..*" Payment : initiates as agent
BillerService "1" -- "0..*" Payment : paid via
Payment "1" *-- "1..*" PaymentStateHistory : logs
Payment "0..1" -- "0..*" LedgerEntry : creates
Payment "1" -- "0..*" RefundRequest : refund of
Payment --> PaymentState
FraudRule ..> Payment : checks

' ===== Notifications =====
class Notification {
  channel : SMS | EMAIL | PUSH
  templateCode
  status : PENDING | SENT | UNDELIVERED
  attempts
  lastAttemptAt
}

AppUser "1" -- "0..*" Notification : receives
Payment "0..1" -- "0..*" Notification : triggers

' ===== Reconciliation =====
class SettlementFile {
  fileDate
  uploadedAt
}

class ReconciliationItem {
  billerReference
  billerAmount : Decimal
  result : MATCHED | AMOUNT_MISMATCH | STATUS_MISMATCH | MISSING_IN_PAYLINK | MISSING_IN_SETTLEMENT
  reviewed
}

Biller "1" -- "0..*" SettlementFile : sends
SettlementFile "1" *-- "0..*" ReconciliationItem : contains
ReconciliationItem "0..*" -- "0..1" Payment : concerns

' ===== Audit and Configuration =====
class AuditLog <<immutable>> {
  actorId
  action
  entityType
  entityId
  details
  createdAt
}

class SystemSetting {
  settingKey
  settingValue
  updatedBy
  updatedAt
}

note right of SystemSetting
  Editable without redeploying (FR-24):
  daily limit 5,000 / 30,000, payment limit 5 - 10,000,
  agent commission 40%, velocity 5 per 60 s then
  10 min block, retries at 1, 5, 15 min
end note

AppUser "0..1" -- "0..*" AuditLog : performs
AppUser "0..1" -- "0..*" SystemSetting : edits

@enduml
